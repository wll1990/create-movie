# MakeMovie 环境变量配置
# 复制此文件为 .env 并填入实际值

# ============================================================
# 主 LLM — 文本模型（剧本/人设/分镜/文案，必填）
# ============================================================
# DeepSeek 示例:
# LLM_API_KEY=sk-your-key
# LLM_API_BASE=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat
#
# 通义千问 示例:
# LLM_API_KEY=sk-your-key
# LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus
#
# 智谱 GLM 示例:
# LLM_API_KEY=your-key
# LLM_API_BASE=https://open.bigmodel.cn/api/paas/v4
# LLM_MODEL=glm-4
LLM_API_KEY=sk-your-api-key-here
LLM_API_BASE=https://api.example.com/v1
LLM_MODEL=gpt-4o

# ============================================================
# 多模态 LLM — 视觉模型（爆款分析看图，可选）
# 不填则分析退化为纯文本模式（视觉维度靠文本推测）
# ============================================================
# 通义千问 VL 示例:
# LLM_VISION_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_VISION_MODEL=qwen-vl-plus
#
# 智谱 GLM-4V 示例:
# LLM_VISION_API_BASE=https://open.bigmodel.cn/api/paas/v4
# LLM_VISION_MODEL=glm-4v
#
# StepFun 示例:
# LLM_VISION_API_BASE=https://api.stepfun.com/v1
# LLM_VISION_MODEL=step-1v-8k
LLM_VISION_API_BASE=
LLM_VISION_MODEL=

# 文生图 (可选，不填则跳过图像生成)
IMAGE_GEN_API_KEY=
IMAGE_GEN_API_BASE=
IMAGE_GEN_MODEL=stable-diffusion-xl

# 语音识别 (可选，不填则使用空文本)
STT_API_KEY=
STT_API_BASE=

# TTS (可选，默认使用免费 edge-tts)
# TTS_PROVIDER=edge
# TTS_VOICE=zh-CN-XiaoxiaoNeural

# 数据库 (默认值即可本地开发)
DB_USERNAME=admin
DB_PASSWORD=password

# MinIO (默认值即可本地开发)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# ============================================================
# AI 视频生成 (必填，用于将分镜帧生成动画片段)
# ============================================================
# 通义万相 Wan2.7 图生视频 (DashScope):
VIDEO_GEN_API_KEY=sk-your-dashscope-key
VIDEO_GEN_API_BASE=https://dashscope.aliyuncs.com
VIDEO_GEN_MODEL=wan2.7-i2v
VIDEO_GEN_POLL_ATTEMPTS=60
VIDEO_GEN_POLL_INTERVAL=5000
VIDEO_GEN_MAX_PARALLEL=1

# ============================================================
# 阿里云 OSS（生成图片公共访问，Wan2.7 图生视频需要）
# ============================================================
OSS_ENDPOINT=movie-create.oss-cn-beijing.aliyuncs.com
OSS_ACCESS_KEY_ID=your-oss-access-key-id
OSS_ACCESS_KEY_SECRET=your-oss-access-key-secret
OSS_BUCKET_NAME=make-movie-assets
