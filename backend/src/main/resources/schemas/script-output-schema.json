{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Script Output",
  "description": "LLM-generated script structure",
  "type": "object",
  "required": ["title", "track", "duration", "scenes"],
  "properties": {
    "title": { "type": "string" },
    "track": { "type": "string" },
    "duration": { "type": "integer" },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["sceneNumber", "location", "dialogues"],
        "properties": {
          "sceneNumber": { "type": "integer" },
          "location": { "type": "string" },
          "timeOfDay": { "type": "string" },
          "summary": { "type": "string" },
          "dialogues": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["characterName", "text", "emotion"],
              "properties": {
                "characterName": { "type": "string" },
                "text": { "type": "string" },
                "emotion": { "type": "string" },
                "durationEstimate": { "type": "number" }
              }
            }
          },
          "durationEstimate": { "type": "integer" }
        }
      }
    }
  }
}
